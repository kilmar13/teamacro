{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for customers, branch staff, and system administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier matching auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User primary email address."
        },
        "fullName": {
          "type": "string",
          "description": "User legal full name."
        },
        "role": {
          "type": "string",
          "enum": ["CUSTOMER", "TELLER", "COMPLIANCE_OFFICER", "BRANCH_MANAGER", "SUPER_ADMIN", "ADMIN", "STAFF"],
          "description": "Authorization role within the banking system."
        },
        "roleTitle": {
          "type": "string",
          "description": "Operational job title or responsibility designation."
        },
        "phone": {
          "type": "string",
          "description": "Verified Nigerian mobile contact number."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the user account is active."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user creation."
        }
      },
      "required": ["id", "email", "fullName", "role", "active"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Super admin authorization document designating administrative privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User UID granted super administrative privileges."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin role was granted."
        }
      },
      "required": ["uid", "email"]
    },
    "Account": {
      "title": "Account",
      "description": "Deposit, savings, or current account record linked to a customer.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "System account ID."
        },
        "userId": {
          "type": "string",
          "description": "Owner customer UID."
        },
        "nuban": {
          "type": "string",
          "pattern": "^[0-9]{10}$",
          "description": "10-digit NUBAN account number."
        },
        "accountName": {
          "type": "string",
          "description": "Full name registered on the bank account."
        },
        "productType": {
          "type": "string",
          "enum": ["SAVINGS", "CURRENT", "SME_ENTERPRISE", "INTERNAL_LEDGER"],
          "description": "Account category."
        },
        "balanceKobo": {
          "type": "number",
          "description": "Available balance in kobo (1 NGN = 100 kobo)."
        },
        "ledgerBalanceKobo": {
          "type": "number",
          "description": "Ledger balance in kobo."
        },
        "currency": {
          "type": "string",
          "enum": ["NGN"],
          "description": "Account currency."
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "DORMANT", "FROZEN", "RESTRICTED"],
          "description": "Account operational status."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation."
        }
      },
      "required": ["id", "userId", "nuban", "accountName", "productType", "balanceKobo", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Immutable ledger transaction entry recording balance movement.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Transaction unique identifier."
        },
        "reference": {
          "type": "string",
          "description": "Unique transaction payment reference."
        },
        "userId": {
          "type": "string",
          "description": "Initiator customer UID."
        },
        "debitAccountId": {
          "type": "string",
          "description": "Source account ID."
        },
        "creditAccountId": {
          "type": "string",
          "description": "Destination account ID or external institution."
        },
        "amountKobo": {
          "type": "number",
          "description": "Transaction amount in kobo."
        },
        "currency": {
          "type": "string",
          "enum": ["NGN"],
          "description": "Currency."
        },
        "channel": {
          "type": "string",
          "enum": ["INTERNET_BANKING", "MOBILE_APP", "BRANCH_COUNTER", "NIP_SWITCH"],
          "description": "Originating channel."
        },
        "type": {
          "type": "string",
          "enum": ["TRANSFER_INTERNAL", "TRANSFER_NIP_OUT", "TRANSFER_NIP_IN", "DEPOSIT_CASH", "WITHDRAWAL_CASH", "FEE"],
          "description": "Transaction classification."
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "SUCCESSFUL", "FAILED", "REVERSED"],
          "description": "Execution status."
        },
        "narration": {
          "type": "string",
          "description": "Payment description/memo."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the transaction was executed."
        }
      },
      "required": ["id", "reference", "userId", "amountKobo", "status"]
    },
    "AccountApplication": {
      "title": "AccountApplication",
      "description": "Digital account onboarding submission.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Application record ID."
        },
        "applicationRef": {
          "type": "string",
          "description": "Human-readable application tracking reference."
        },
        "accountType": {
          "type": "string",
          "enum": ["SAVINGS", "CURRENT", "SME_ENTERPRISE"]
        },
        "fullName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "bvn": {
          "type": "string",
          "pattern": "^[0-9]{11}$"
        },
        "status": {
          "type": "string",
          "enum": ["SUBMITTED", "PENDING_KYC", "APPROVED", "REJECTED"]
        },
        "submittedAt": {
          "type": "string"
        }
      },
      "required": ["id", "applicationRef", "fullName", "email", "phone", "status"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Singleton configuration and root lockdown settings for the platform.",
      "type": "object",
      "properties": {
        "initialized": {
          "type": "boolean",
          "description": "Whether the root authority has been initialized and locked."
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the authoritative Lifetime Super Admin."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "description": "Normalized email address of the Lifetime Super Admin."
        },
        "role": {
          "type": "string",
          "enum": ["LIFETIME_SUPER_ADMIN"],
          "description": "Singleton primary administrative role."
        },
        "fullName": {
          "type": "string",
          "description": "Legal full name of the Lifetime Super Admin."
        },
        "phone": {
          "type": "string",
          "description": "Official contact phone number."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "setupVersion": {
          "type": "number",
          "description": "Protocol version."
        }
      },
      "required": ["initialized", "ownerUid", "ownerEmail", "role", "setupVersion"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Operational staff record with assigned duty and granular permission flags.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Staff user UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Staff corporate email address."
        },
        "fullName": {
          "type": "string",
          "description": "Staff legal full name."
        },
        "phone": {
          "type": "string",
          "description": "Staff contact phone number."
        },
        "role": {
          "type": "string",
          "enum": ["STAFF"],
          "description": "Staff role."
        },
        "duty": {
          "type": "string",
          "description": "Assigned operational duty."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["uid", "email", "fullName", "role"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered TEAMACRO customer profile for Fixed Target, Daily Ajo, Everyhome Food, Leocash, and Loans.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Customer unique ID."
        },
        "customerCode": {
          "type": "string",
          "description": "TEAMACRO customer reference code."
        },
        "fullName": {
          "type": "string",
          "description": "Customer full legal name."
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "dormant"],
          "description": "Customer status."
        }
      },
      "required": ["id", "fullName", "phone"]
    },
    "SystemOwnership": {
      "title": "SystemOwnership",
      "description": "Authoritative singleton record defining the unique Lifetime Super Admin owner.",
      "type": "object",
      "properties": {
        "isInitialized": {
          "type": "boolean",
          "description": "Whether the root ownership record is initialized."
        },
        "lockdownEnforced": {
          "type": "boolean",
          "description": "Whether initial root setup lockdown is enforced."
        },
        "ownerUserId": {
          "type": "string",
          "description": "Unique UID of the Lifetime Super Admin."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "description": "Official email of the Lifetime Super Admin."
        },
        "ownerFullName": {
          "type": "string",
          "description": "Full legal name of the Lifetime Super Admin."
        },
        "establishedAt": {
          "type": "string",
          "description": "ISO timestamp when ownership was established."
        },
        "setupVersion": {
          "type": "number",
          "description": "Ownership schema version."
        }
      },
      "required": ["isInitialized", "ownerUserId", "ownerEmail"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Hashed access code invitation metadata for Admin and Staff provisioning.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Invitation identifier."
        },
        "email": {
          "type": "string",
          "description": "Target recipient email."
        },
        "accessType": {
          "type": "string",
          "enum": ["Admin", "Staff"],
          "description": "Target role category."
        },
        "duty": {
          "type": "string",
          "description": "Assigned operational responsibility."
        },
        "codeHash": {
          "type": "string",
          "description": "Salted SHA-256 hash of the access code."
        },
        "codeSalt": {
          "type": "string",
          "description": "Cryptographic salt for the access code hash."
        },
        "expiresAt": {
          "type": "number",
          "description": "Expiration epoch timestamp in milliseconds."
        },
        "used": {
          "type": "boolean",
          "description": "Whether the invitation has been redeemed."
        },
        "revoked": {
          "type": "boolean",
          "description": "Whether the invitation has been revoked."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp."
        },
        "createdBy": {
          "type": "string",
          "description": "Creator UID."
        }
      },
      "required": ["id", "email", "accessType", "duty", "codeHash", "codeSalt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and governance audit trail record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit record identifier."
        },
        "actorId": {
          "type": "string",
          "description": "UID of the user performing the action."
        },
        "actorName": {
          "type": "string",
          "description": "Full name of the actor."
        },
        "actorRole": {
          "type": "string",
          "description": "Role of the actor at time of action."
        },
        "action": {
          "type": "string",
          "description": "Action code."
        },
        "resource": {
          "type": "string",
          "description": "Target API route or resource."
        },
        "details": {
          "type": "string",
          "description": "Redacted diagnostic details."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp."
        },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "DENIED", "LOCKED", "FLAGGED"],
          "description": "Outcome status."
        }
      },
      "required": ["id", "actorId", "action", "resource", "timestamp", "status"]
    },
    "Session": {
      "title": "Session",
      "description": "Server-validated session metadata keyed by SHA-256 tokenHash (never plaintext token).",
      "type": "object",
      "properties": {
        "tokenHash": {
          "type": "string",
          "description": "SHA-256 hash of the session token."
        },
        "userId": {
          "type": "string",
          "description": "Authenticated user UID."
        },
        "email": {
          "type": "string",
          "description": "Authenticated user email."
        },
        "role": {
          "type": "string",
          "description": "Authenticated role."
        },
        "mfaVerified": {
          "type": "boolean",
          "description": "Whether MFA was verified for this session."
        },
        "createdAt": {
          "type": "number",
          "description": "Creation epoch timestamp."
        },
        "expiresAt": {
          "type": "number",
          "description": "Expiration epoch timestamp."
        },
        "revoked": {
          "type": "boolean",
          "description": "Whether the session has been revoked."
        }
      },
      "required": ["tokenHash", "userId", "email", "role", "expiresAt"]
    }
  },
  "firestore": {
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Singleton configuration and root lockdown settings for the platform."
    },
    "/system_ownership/{ownershipId}": {
      "schema": { "$ref": "#/entities/SystemOwnership" },
      "description": "Authoritative singleton record for Lifetime Super Admin ownership."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile records containing account credentials and roles."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin authorization mapping for trusted platform administrators."
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Staff authorization mapping and operational duty records."
    },
    "/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Hashed access authorization invitations."
    },
    "/audit_logs/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security and operational audit logs."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Hashed server session records."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer profile records across TEAMACRO financial programmes."
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Customer banking deposit, current, and savings accounts."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Authoritative immutable double-entry ledger transactions."
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/AccountApplication" },
      "description": "Public customer onboarding account opening submissions."
    }
  }
}
