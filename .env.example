# PORT: Port to listen on. Cloud Run automatically injects PORT=8080.
PORT="8080"

# NODE_ENV: Set to 'production' for production builds.
NODE_ENV="production"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required if invoking Gemini models via server routes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE CLIENT CONFIGURATION (Public Web SDK identifiers — safe for browser bundles when restricted by domain/API in Google Cloud Console)
VITE_FIREBASE_PROJECT_ID="teamacro-a1849"
VITE_FIREBASE_APP_ID="1:419612802:web:82d48b940af93927734c9b"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="teamacro-a1849.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-teamacro-1c75b7f5-7b8e-4f90-9452-2820167e5d5a"
VITE_FIREBASE_STORAGE_BUCKET="teamacro-a1849.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="419612802"

# FIREBASE SERVER CONFIGURATION (Server-side Identity Toolkit & Firebase Admin SDK credentials — NEVER prefix private keys with VITE_)
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_PROJECT_ID="teamacro-a1849"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-teamacro-1c75b7f5-7b8e-4f90-9452-2820167e5d5a"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@teamacro-a1849.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional alternative to FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY: full JSON string of the service account key
FIREBASE_SERVICE_ACCOUNT_KEY=""

# SERVER SESSION SIGNING SECRET (Used for stateless HMAC-SHA256 session tokens across Vercel serverless instances)
SESSION_SECRET="YOUR_SECURE_RANDOM_SESSION_SECRET"

