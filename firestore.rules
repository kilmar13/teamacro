rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY HELPERS & PRIMITIVES
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUserActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && isUserActive() && (
        request.auth.token.email == 'eromoseledavidson68@gmail.com' ||
        (exists(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin) &&
         (get(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin).data.ownerEmail == request.auth.token.email)) ||
        (exists(/databases/$(database)/documents/system_ownership/lifetimeSuperAdmin) &&
         (get(/databases/$(database)/documents/system_ownership/lifetimeSuperAdmin).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/system_ownership/lifetimeSuperAdmin).data.ownerUserId == request.auth.uid))
      );
    }

    function isAdmin() {
      return isSignedIn() && isUserActive() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isSignedIn() && isUserActive() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function canStaffViewCustomers() {
      return isStaff() && (
        !('permissions' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.canViewCustomers == true ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.manage_customers == true
      );
    }

    function canStaffRegisterCustomers() {
      return isStaff() && (
        !('permissions' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.canRegisterCustomers == true ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.manage_customers == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // ENTITY VALIDATION HELPERS
    // =========================================================================

    function isValidSystemSetting(data) {
      return data.keys().hasAll(['initialized', 'ownerUid', 'ownerEmail', 'role']) &&
        data.initialized == true &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.ownerEmail is string && data.ownerEmail.size() <= 128 &&
        data.role == 'LIFETIME_SUPER_ADMIN';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'fullName', 'role']) &&
        data.email is string && data.email.size() <= 128 &&
        data.fullName is string && data.fullName.size() <= 120 &&
        data.role in ['CUSTOMER', 'TELLER', 'COMPLIANCE_OFFICER', 'BRANCH_MANAGER', 'SUPER_ADMIN', 'LIFETIME_SUPER_ADMIN', 'ADMIN', 'STAFF'];
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['email']) &&
        data.email is string && data.email.size() <= 128 &&
        (!('role' in data) || data.role in ['ADMIN', 'SUPER_ADMIN', 'LIFETIME_SUPER_ADMIN']);
    }

    function isValidStaffDoc(data) {
      return data.keys().hasAll(['email']) &&
        data.email is string && data.email.size() <= 128 &&
        (!('role' in data) || data.role in ['STAFF', 'staff']);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'fullName', 'phone']) &&
        data.id is string && data.id.size() <= 128 &&
        data.fullName is string && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'userId', 'nuban', 'accountName', 'productType', 'balanceKobo', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'nuban', 'accountName', 'productType', 'balanceKobo', 'ledgerBalanceKobo', 'currency', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.nuban is string && data.nuban.matches('^[0-9]{10}$') &&
        data.accountName is string && data.accountName.size() <= 120 &&
        data.productType in ['SAVINGS', 'CURRENT', 'SME_ENTERPRISE', 'INTERNAL_LEDGER'] &&
        data.balanceKobo is number && data.balanceKobo >= 0 &&
        data.status in ['ACTIVE', 'DORMANT', 'FROZEN', 'RESTRICTED'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'reference', 'userId', 'amountKobo', 'status']) &&
        data.keys().hasOnly(['id', 'reference', 'userId', 'debitAccountId', 'creditAccountId', 'amountKobo', 'currency', 'channel', 'type', 'status', 'narration', 'createdAt', 'beneficiaryName', 'beneficiaryBank']) &&
        data.id is string && data.id.size() <= 128 &&
        data.reference is string && data.reference.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.amountKobo is number && data.amountKobo > 0 &&
        data.status in ['PENDING', 'SUCCESSFUL', 'FAILED', 'REVERSED'];
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'applicationRef', 'fullName', 'email', 'phone', 'status']) &&
        data.keys().hasOnly(['id', 'applicationRef', 'accountType', 'tierRequested', 'fullName', 'email', 'phone', 'bvn', 'nin', 'status', 'submittedAt', 'residentialAddress', 'state', 'lga', 'occupation']) &&
        data.id is string && data.id.size() <= 128 &&
        data.applicationRef is string && data.applicationRef.size() <= 64 &&
        data.fullName is string && data.fullName.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.status in ['SUBMITTED', 'PENDING_KYC', 'APPROVED', 'REJECTED'];
    }

    // =========================================================================
    // GLOBAL DEFAULT-DENY FALLBACK
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 0. SYSTEM SETTINGS & SYSTEM OWNERSHIP SINGLETONS
    // =========================================================================
    match /systemSettings/{settingId} {
      allow get, list: if true;
      allow create: if settingId == 'lifetimeSuperAdmin' &&
        isSignedIn() &&
        incoming().ownerUid == request.auth.uid &&
        !exists(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin) &&
        isValidSystemSetting(incoming());
      allow update: if settingId == 'lifetimeSuperAdmin' &&
        isSuperAdmin() &&
        isValidSystemSetting(incoming());
      allow delete: if false;
    }

    match /system_ownership/{ownershipId} {
      allow get, list: if true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. ADMINS & STAFF COLLECTIONS
    // =========================================================================
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update: if isValidId(adminId) && isValidAdminDoc(incoming());
      allow delete: if isSuperAdmin();
    }

    match /staff/{staffId} {
      allow get, list: if true;
      allow create, update: if isValidId(staffId) && isValidStaffDoc(incoming());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /invitations/{invitationId} {
      allow get, list, create, update: if isValidId(invitationId);
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /audit_logs/{auditId} {
      allow get, list, create: if isValidId(auditId);
      allow update, delete: if false;
    }

    match /sessions/{sessionId} {
      allow get, list, create, update, delete: if isValidId(sessionId);
    }

    // =========================================================================
    // 2.5. CUSTOMERS COLLECTION
    // =========================================================================
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update: if isValidId(customerId) && isValidCustomer(incoming());
      allow delete: if isValidId(customerId) && isSuperAdmin();
    }

    // =========================================================================
    // 3. ACCOUNTS COLLECTION
    // =========================================================================
    match /accounts/{accountId} {
      allow get, list: if true;
      allow create: if isValidId(accountId) && isValidAccount(incoming());
      allow update: if isValidId(accountId) && isValidAccount(incoming());
      allow delete: if false;
    }

    // =========================================================================
    // 4. TRANSACTIONS COLLECTION (IMMUTABLE DOUBLE-ENTRY LEDGER)
    // =========================================================================
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create: if isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 5. APPLICATIONS (ACCOUNT ONBOARDING)
    // =========================================================================
    match /applications/{applicationId} {
      allow get, list: if true;
      allow create: if isValidId(applicationId) && isValidApplication(incoming()) && incoming().status == 'SUBMITTED';
      allow update: if isValidId(applicationId) && isValidApplication(incoming());
      allow delete: if isValidId(applicationId) && isSuperAdmin();
    }
  }
}
