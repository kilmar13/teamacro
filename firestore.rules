rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY HELPERS & PRIMITIVES
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUserActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && isUserActive() && (
        (exists(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin) &&
         get(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin).data.ownerUid == request.auth.uid) ||
        (request.auth.token.email == 'eromoseledavidson68@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isAdmin() {
      return isSignedIn() && isUserActive() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isSignedIn() && isUserActive() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function canStaffViewCustomers() {
      return isStaff() && (
        !('permissions' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.canViewCustomers == true
      );
    }

    function canStaffRegisterCustomers() {
      return isStaff() && (
        !('permissions' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.canRegisterCustomers == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // ENTITY VALIDATION HELPERS
    // =========================================================================

    function isValidSystemSetting(data) {
      return data.keys().hasAll(['initialized', 'ownerUid', 'ownerEmail', 'role', 'setupVersion']) &&
        data.keys().hasOnly(['initialized', 'ownerUid', 'ownerEmail', 'role', 'fullName', 'phone', 'createdAt', 'setupVersion']) &&
        data.initialized == true &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.ownerEmail is string && data.ownerEmail.size() <= 128 &&
        data.role == 'LIFETIME_SUPER_ADMIN' &&
        data.setupVersion is number;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'role', 'active']) &&
        data.keys().hasOnly([
          'id', 'uid', 'email', 'fullName', 'role', 'roleTitle', 'duty',
          'phone', 'active', 'status', 'createdBy', 'createdAt', 'updatedAt',
          'branchId', 'staffCode', 'permissions', 'assignedModules'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        data.fullName is string && data.fullName.size() <= 100 &&
        data.role in ['CUSTOMER', 'TELLER', 'COMPLIANCE_OFFICER', 'BRANCH_MANAGER', 'SUPER_ADMIN', 'ADMIN', 'STAFF'] &&
        data.active is bool;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly([
          'uid', 'id', 'email', 'fullName', 'phone', 'role', 'roleTitle',
          'duty', 'status', 'active', 'createdBy', 'createdAt', 'updatedAt',
          'permissions', 'assignedModules'
        ]) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128;
    }

    function isValidStaffDoc(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly([
          'uid', 'id', 'email', 'fullName', 'phone', 'role', 'roleTitle',
          'duty', 'status', 'active', 'createdBy', 'createdAt', 'updatedAt',
          'permissions', 'staffCode', 'branchId', 'assignedModules'
        ]) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        (!('role' in data) || data.role == 'STAFF');
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'fullName', 'phone']) &&
        data.id is string && data.id.size() <= 128 &&
        data.fullName is string && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() <= 40;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'userId', 'nuban', 'accountName', 'productType', 'balanceKobo', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'nuban', 'accountName', 'productType', 'balanceKobo', 'ledgerBalanceKobo', 'currency', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.nuban is string && data.nuban.matches('^[0-9]{10}$') &&
        data.accountName is string && data.accountName.size() <= 120 &&
        data.productType in ['SAVINGS', 'CURRENT', 'SME_ENTERPRISE', 'INTERNAL_LEDGER'] &&
        data.balanceKobo is number && data.balanceKobo >= 0 &&
        data.status in ['ACTIVE', 'DORMANT', 'FROZEN', 'RESTRICTED'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'reference', 'userId', 'amountKobo', 'status']) &&
        data.keys().hasOnly(['id', 'reference', 'userId', 'debitAccountId', 'creditAccountId', 'amountKobo', 'currency', 'channel', 'type', 'status', 'narration', 'createdAt', 'beneficiaryName', 'beneficiaryBank']) &&
        data.id is string && data.id.size() <= 128 &&
        data.reference is string && data.reference.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.amountKobo is number && data.amountKobo > 0 &&
        data.status in ['PENDING', 'SUCCESSFUL', 'FAILED', 'REVERSED'];
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'applicationRef', 'fullName', 'email', 'phone', 'status']) &&
        data.keys().hasOnly(['id', 'applicationRef', 'accountType', 'tierRequested', 'fullName', 'email', 'phone', 'bvn', 'nin', 'status', 'submittedAt', 'residentialAddress', 'state', 'lga', 'occupation']) &&
        data.id is string && data.id.size() <= 128 &&
        data.applicationRef is string && data.applicationRef.size() <= 64 &&
        data.fullName is string && data.fullName.size() <= 100 &&
        data.email is string && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.status in ['SUBMITTED', 'PENDING_KYC', 'APPROVED', 'REJECTED'];
    }

    // =========================================================================
    // GLOBAL DEFAULT-DENY FALLBACK
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 0. SYSTEM SETTINGS & SINGLETON LIFETIME SUPER ADMIN ROOT LOCKDOWN
    // Only the authorised Lifetime Super Admin can establish or manage root ownership.
    // =========================================================================
    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if settingId == 'lifetimeSuperAdmin' &&
        isSignedIn() &&
        incoming().ownerUid == request.auth.uid &&
        !exists(/databases/$(database)/documents/systemSettings/lifetimeSuperAdmin) &&
        isValidSystemSetting(incoming());
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // Admins cannot promote themselves or others to SUPER_ADMIN or ADMIN.
    // Users cannot modify their own roles or active status.
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        isSuperAdmin() ||
        (isAdmin() && incoming().role in ['STAFF', 'CUSTOMER', 'TELLER', 'COMPLIANCE_OFFICER']) ||
        (isOwner(userId) && incoming().id == request.auth.uid && incoming().role == 'CUSTOMER')
      );
      allow update: if isValidId(userId) && isValidUser(incoming()) && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          existing().role in ['STAFF', 'CUSTOMER', 'TELLER', 'COMPLIANCE_OFFICER'] &&
          incoming().role in ['STAFF', 'CUSTOMER', 'TELLER', 'COMPLIANCE_OFFICER']
        ) ||
        (
          isOwner(userId) &&
          incoming().id == existing().id &&
          incoming().role == existing().role &&
          incoming().active == existing().active &&
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone'])
        )
      );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // =========================================================================
    // 2. ADMINS & STAFF COLLECTIONS
    // Only Lifetime Super Admin can appoint/modify Admins.
    // Staff cannot create Admin, Super Admin, or Staff accounts.
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isSuperAdmin() && isValidAdminDoc(incoming());
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    match /staff/{staffId} {
      allow get: if isValidId(staffId) && (isOwner(staffId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(staffId) && isAdmin() && isValidStaffDoc(incoming());
      allow delete: if isValidId(staffId) && isAdmin();
    }

    // =========================================================================
    // 2.5. CUSTOMERS COLLECTION
    // Unauthenticated visitors cannot read or modify customer records.
    // Customers can only read their own record; Staff require assigned permissions.
    // =========================================================================
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && (isOwner(customerId) || isAdmin() || canStaffViewCustomers());
      allow list: if isAdmin() || canStaffViewCustomers();
      allow create, update: if isValidId(customerId) && isValidCustomer(incoming()) && (isAdmin() || canStaffRegisterCustomers());
      allow delete: if isValidId(customerId) && isSuperAdmin();
    }

    // =========================================================================
    // 3. ACCOUNTS COLLECTION
    // Customers cannot access another customer's account or modify balances.
    // =========================================================================
    match /accounts/{accountId} {
      allow get: if isValidId(accountId) && ((isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(accountId) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid && incoming().balanceKobo == 0 && isValidAccount(incoming()))
      );
      allow update: if isValidId(accountId) && isAdmin() && isValidAccount(incoming());
      allow delete: if false;
    }

    // =========================================================================
    // 4. TRANSACTIONS COLLECTION (IMMUTABLE DOUBLE-ENTRY LEDGER)
    // =========================================================================
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && ((isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(transactionId) && (
        isAdmin() ||
        (isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'PENDING' && isValidTransaction(incoming()))
      );
      allow update: if false;
      allow delete: if false;
    }

    // =========================================================================
    // 5. APPLICATIONS (ACCOUNT ONBOARDING)
    // =========================================================================
    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(applicationId) && isValidApplication(incoming()) && incoming().status == 'SUBMITTED';
      allow update: if isValidId(applicationId) && isAdmin() && isValidApplication(incoming());
      allow delete: if isValidId(applicationId) && isSuperAdmin();
    }
  }
}
